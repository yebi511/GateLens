{
  "name": "gatelens-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=9"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
