# Copying this file manually is optional. docker-server.sh creates docker.env
# with a random token on its first run.
GATELENS_AGENT_TOKEN=replace-with-a-long-random-value
GATELENS_API_IMAGE=ghcr.io/gatelens/gatelens-api:dev
GATELENS_WEB_IMAGE=ghcr.io/gatelens/gatelens-web:dev
GATELENS_BIND_ADDRESS=0.0.0.0
GATELENS_HTTP_PORT=8080
GATELENS_SERVER_CLUSTER_ID=federation
GATELENS_STALE_AFTER=2m

# Replace the image values with your registry and release tag when needed.
